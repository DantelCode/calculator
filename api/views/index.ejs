<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="utf-8">
  <title>Calculator</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <canvas id="bg-stars" aria-hidden="true"></canvas>

  <div class="calculator_case" role="application" aria-label="Calculator">
    <div class="calc-header">
      <p class="title">Calculator</p>
      <button id="themeToggle" class="theme-toggle" aria-label="Toggle theme">
        <!-- sun/moon SVG -->
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path id="themeIcon" d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4M12 7a5 5 0 100 10 5 5 0 000-10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <div id="display" class="display">
      <div id="upper" class="upper" aria-hidden="true"></div>
      <div id="lower" class="lower" aria-live="polite"></div>
    </div>

    <div id="sub_grid" class="sub-grid" aria-hidden="false"></div>

    <div id="main_grid" class="main-grid" aria-hidden="false"></div>
  </div>

  <script type="text/javascript" src="/index.js"></script>
</body>

</html>